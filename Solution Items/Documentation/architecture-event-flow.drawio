<mxfile host="app.diagrams.net"><diagram name="Runtime - Event-driven notification flow" id="architecture-event-flow"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="460"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cmd" value="&lt;b&gt;Command&lt;/b&gt;&lt;br&gt;e.g. CreateOrderCommand /&lt;br&gt;UpdateBoardCommand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="190" height="100" as="geometry"/></mxCell><mxCell id="repo" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;SaveChangesAsync, then&lt;br&gt;IPublisher publishes domain events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="270" y="160" width="220" height="100" as="geometry"/></mxCell><mxCell id="mq" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;Rebus topic exchange&lt;br&gt;per event type" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E65100;fontColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="540" y="160" width="190" height="100" as="geometry"/></mxCell><mxCell id="cons" value="&lt;b&gt;Consumers&lt;/b&gt;&lt;br&gt;IHandleMessages&amp;lt;TEvent&amp;gt;&lt;br&gt;(Notification, Operative)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="190" height="100" as="geometry"/></mxCell><mxCell id="hub" value="&lt;b&gt;SignalR Hub&lt;/b&gt;&lt;br&gt;Push to connected clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;fontColor=#FFFFFF;strokeColor=#222222;" vertex="1" parent="1"><mxGeometry x="1010" y="160" width="160" height="100" as="geometry"/></mxCell><mxCell id="e0" value="Domain event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="cmd" target="repo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="repo" target="mq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Subscribe&lt;T&gt;()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="mq" target="cons"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Push update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;" edge="1" parent="1" source="cons" target="hub"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>